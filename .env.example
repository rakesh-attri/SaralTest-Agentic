# Copy to .env (git-ignored). Prefer Windows Credential Manager via keytar for secrets.
QA_DEFAULT_ORG=fc-admin
QA_BROWSER=chromium
SF_ECA_CLIENT_ID=
# Path to the ECA private key (prefer Windows Credential Manager; never commit the key). Keep comments on their own line.
SF_JWT_KEY_PATH=
QA_AUTONOMY=L2
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434
JIRA_BASE_URL=https://<your-site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces   # optional, only if phoenix exporter enabled
# Optional: Azure DevOps work items as input (qa analyze --ado <id>)
ADO_ORG_URL=   # e.g. https://dev.azure.com/<org>/<project>
ADO_PAT=       # prefer Windows Credential Manager; never commit
